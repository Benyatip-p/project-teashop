# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=teashop_user
DB_PASSWORD=teashop_pass
DB_NAME=teashop_db

# PgAdmin Configuration (for database management)
PGADMIN_DEFAULT_EMAIL=admin@teashop.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# Note: When running with Docker Compose, DB_HOST will be overridden to 'db'
# The application will use the database service name as the host